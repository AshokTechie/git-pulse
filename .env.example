# ------------------------------------------------------------------
# GitPulse - environment configuration.
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# ---- Database ----
# Development: SQLite is used by default (no Docker/PG required)
# Production: Set DATABASE_URL for PostgreSQL
DATABASE_URL_SQLITE="file:./dev.db"
# Uncomment for PostgreSQL production:
# DATABASE_URL="postgresql://gitpulse:gitpulse@localhost:5432/gitpulse?schema=public"

# ---- Redis (background jobs) ----
# Development: Optional - app works without Redis
# Production: Set REDIS_URL for BullMQ workers
REDIS_URL="redis://localhost:6379"

# ---- Server ----
PORT=4000
HOST=0.0.0.0
# Where the frontend lives (used for OAuth redirects back to the app)
FRONTEND_URL="http://localhost:5173"

# ---- GitHub OAuth App ----
# Create an OAuth App at https://github.com/settings/developers
# Set these to enable real GitHub OAuth (optional for dev)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Must match the callback URL registered in the GitHub OAuth app
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# ---- Security ----
# A strong random secret used to encrypt stored GitHub tokens and sign cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- AI (LLM) ----
# Used by the AI insights service. API base + key.
# Set to enable AI insights (optional for dev)
AI_API_KEY=""
AI_API_BASE="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ---- Development ----
# When true, development authentication is enabled (no GitHub credentials needed)
ALLOW_DEV_AUTH="true"

# ---- CORS ----
# Comma separated list of allowed origins for the API.
CORS_ORIGINS="http://localhost:5173"